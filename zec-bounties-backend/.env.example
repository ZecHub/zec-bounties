# zec-bounties-backend environment variables
#
# Copy this file to .env and fill it in:   cp .env.example .env
# It lists every variable the backend code reads.
#
# [required] the backend won't start (or won't work locally) without it.
# [optional] only needed for the feature named; leave it blank for local dev.

# ---------------------------------------------------------------------------
# Core: required for local development
# ---------------------------------------------------------------------------

# [required] PostgreSQL connection string (prisma/schema.prisma uses provider "postgresql").
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zec_bounties?schema=public"

# [required] Secret used to sign and verify login tokens. Any long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET="replace-with-a-long-random-string"

# [required] Port the backend listens on. 9000 matches the frontend's dev backendUrl (zec-bounties-frontend/lib/configENV.ts); if unset, server.js uses 9001.
PORT=9000

# [required] Web-push key pair. The backend exits on startup without these (utils/pushNotifications.js). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# [required] Web-push contact. Must be a mailto: address or an https: URL.
VAPID_EMAIL=mailto:you@example.com

# ---------------------------------------------------------------------------
# Service URLs: the values below work for local development
# ---------------------------------------------------------------------------

# [optional] Frontend origin, used for CORS and OAuth redirects. Code default: http://localhost:3000
FRONTEND_URL=http://localhost:3000
# [optional] Public URL of this backend, used to build the Discord OAuth callback (routes/auth.js). Code default is http://localhost:5000, so keep this in step with PORT.
BACKEND_URL=http://localhost:9000
# [optional] Redis connection string. Code default: redis://localhost:6379. A running Redis is required either way.
REDIS_URL=redis://localhost:6379
# [optional] Runtime mode. Anything other than "production" enables dev behaviour: bounty emails are skipped, other email goes to DEV_EMAIL_FALLBACK, all chains are listed, and the weekly-limit overrides apply.
NODE_ENV=development

# ---------------------------------------------------------------------------
# GitHub login (optional locally; needed to sign in with GitHub)
# Create an OAuth app at https://github.com/settings/developers with callback http://localhost:9000/auth/github/callback
# ---------------------------------------------------------------------------

# [optional] GitHub OAuth app client ID.
GITHUB_CLIENT_ID=
# [optional] GitHub OAuth app client secret.
GITHUB_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Discord (optional locally)
# ---------------------------------------------------------------------------

# [optional] Discord OAuth app client ID, for linking a Discord account. Redirect URI: ${BACKEND_URL}/auth/discord/callback
DISCORD_CLIENT_ID=
# [optional] Discord OAuth app client secret.
DISCORD_CLIENT_SECRET=
# [optional] Bot token used to open a Discord thread for a bounty (utils/discord/discordNotify.js).
DISCORD_BOT_TOKEN=
# [optional] Channel ID the bot creates bounty threads in.
DISCORD_BOUNTY_CHANNEL_ID=
# [optional] Webhook URL that announces new public bounties.
DISCORD_NOTIFY_WEBHOOK_URL=
# [optional] Webhook URL notified when a bounty is assigned (utils/discord/discordAssignWebhook.js).
DISCORD_BOT_WEBHOOK_URL=
# [optional] Shared secret sent with the assignment webhook; the webhook is skipped if this or DISCORD_BOT_WEBHOOK_URL is unset.
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Email (optional locally)
# ---------------------------------------------------------------------------

# [optional] Gmail address used to send notification emails (utils/mailer.js uses smtp.gmail.com).
SMTP_USER=
# [optional] App password for SMTP_USER.
SMTP_PASS=
# [optional] Outside production, all outgoing email is redirected to this address (utils/sendMail.js).
DEV_EMAIL_FALLBACK=

# ---------------------------------------------------------------------------
# File uploads via Pinata/IPFS (optional locally; uploads fail without PINATA_JWT)
# ---------------------------------------------------------------------------

# [optional] Pinata API JWT.
PINATA_JWT=
# [optional] Pinata gateway host. Code default: gateway.pinata.cloud
PINATA_GATEWAY=

# ---------------------------------------------------------------------------
# Weekly bounty-creation limits (optional; dev only, ignored when NODE_ENV=production)
# ---------------------------------------------------------------------------

# [optional] Weekly limit for gold-star users in development. Code default: 2. Don't leave it empty: an empty value counts as 0.
WEEKLY_BOUNTY_LIMIT_GOLD=2
# [optional] Weekly limit for other users in development. Code default: 1. Don't leave it empty: an empty value counts as 0.
WEEKLY_BOUNTY_LIMIT_STANDARD=1

# ---------------------------------------------------------------------------
# Zcash wallets and payments (optional locally; needs zingo-cli and a Zcash node, see https://zechub.wiki/developers)
# ---------------------------------------------------------------------------

# [optional] Path to the zingo-cli binary used for wallet operations (utils/zingo/).
ZINGO_CLI=
# [optional] Chain for the system wallet used by /auth/verify-zaddress and /auth/verify-uaddress, e.g. mainnet.
LOGIN_WALLET_CHAIN=
# [optional] Lightwalletd server URL for the system wallet.
ZCASH_SERVER_URL=
# [optional] Data directory for the system wallet.
LOGIN_WALLET_DATA_DIR=
# [optional] Verification wallet read by getVerificationZcashParams() (helpers/zcash/zcashHelper.js), which nothing calls on main yet.
ZCASH_VERIFICATION_WALLET_PATH=
# [optional] Chain for the verification wallet. Code default: mainnet
ZCASH_VERIFICATION_CHAIN=
# [optional] Server for the verification wallet. Code default: https://zec.rocks:443
ZCASH_VERIFICATION_SERVER=
# [optional] JSON-RPC endpoint used by the admin payout route POST /api/transactions/pay/:bountyId.
ZCASH_RPC_URL=
# [optional] JSON-RPC username.
ZCASH_RPC_USER=
# [optional] JSON-RPC password.
ZCASH_RPC_PASS=
# [optional] Wallet address payouts are sent from (z_sendmany).
ADMIN_WALLET_ADDRESS=
